{
  "name": "react-tsx-tailwind-environment",
  "version": "1.0.0",
  "private": true,
  "description": "A starter environment for React with TypeScript and Tailwind CSS.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test:regression": "tsc -p tsconfig.regression.json && node .regression-build/tests/regression/regression.js check",
    "test:regression:generate": "tsc -p tsconfig.regression.json && node .regression-build/tests/regression/regression.js generate"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.5.3",
    "vite": "^8.0.14"
  }
}
