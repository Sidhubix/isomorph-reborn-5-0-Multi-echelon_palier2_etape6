rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test
    match /test/connection {
      allow read: if true;
    }

    // User Profile Document (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII isolation - no listing of users
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // User Settings Subcollection (/users/{userId}/settings/{settingId})
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingId);
        allow delete: if isOwner(userId);
      }

      // User Saved Datasets Subcollection (/users/{userId}/datasets/{datasetId})
      match /datasets/{datasetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(datasetId);
        allow delete: if isOwner(userId);
      }

      // User Batch Result Runs Subcollection (/users/{userId}/batch_runs/{runId})
      match /batch_runs/{runId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(runId);
        allow delete: if isOwner(userId);
      }

      // User Simulation Processes Subcollection (/users/{userId}/processes/{processId})
      match /processes/{processId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(processId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
