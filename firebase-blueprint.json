{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information synchronized upon Google login",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User parameters, simulation options and model hypotheses",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "manualParams": { "type": "object" },
        "generatorConfig": { "type": "object" },
        "selectedProfile": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "updatedAt"]
    },
    "SavedDataset": {
      "title": "SavedDataset",
      "description": "Saved simulation dataset and scenarios generated by the user",
      "type": "object",
      "properties": {
        "datasetId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "scenariosCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "config": { "type": "object" },
        "dataJson": { "type": "string" }
      },
      "required": ["datasetId", "userId", "name", "createdAt", "updatedAt"]
    },
    "BatchResultRun": {
      "title": "BatchResultRun",
      "description": "Saved batch non-linear fit and resilience KPI results",
      "type": "object",
      "properties": {
        "runId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "curvesCount": { "type": "number" },
        "avgR2": { "type": "number" },
        "createdAt": { "type": "string" },
        "resilienceCsv": { "type": "string" }
      },
      "required": ["runId", "userId", "title", "curvesCount", "createdAt"]
    },
    "SimulationProcess": {
      "title": "SimulationProcess",
      "description": "Complete saved simulation process bundle with parameters, configuration, scenario structure, and resilience results",
      "type": "object",
      "properties": {
        "processId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "summary": { "type": "object" },
        "config": { "type": "object" },
        "resilienceRows": { "type": "array" },
        "resilienceCsv": { "type": "string" },
        "compactDataset": { "type": "object" }
      },
      "required": ["processId", "userId", "name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Private user account profile"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "UserSettings" },
      "description": "User parameters and configuration options"
    },
    "/users/{userId}/datasets/{datasetId}": {
      "schema": { "$ref": "SavedDataset" },
      "description": "User saved scenario simulation datasets"
    },
    "/users/{userId}/batch_runs/{runId}": {
      "schema": { "$ref": "BatchResultRun" },
      "description": "User saved batch fit and resilience runs"
    },
    "/users/{userId}/processes/{processId}": {
      "schema": { "$ref": "SimulationProcess" },
      "description": "User saved simulation process catalogs (parameters, scenario configurations, and results)"
    }
  }
}
